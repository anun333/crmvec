#!/bin/sh
# crmvec-stamp DIR: record in DIR that the results in it were computed with crmvec's correctly rounded math, so that
# whoever reads them later knows. Writes DIR/crmvec-libm.json; when DIR holds a BIDS dataset_description.json, also
# adds one crmvec entry to its GeneratedBy list. It records what it finds in the environment it runs in (the one the
# program ran in): libcrpreload.so in LD_PRELOAD (scalar math: crmvec-run --libm, the crmvec-libm conda package or
# module), crmvec's directory in LD_LIBRARY_PATH (vector math: crmvec-run). With neither, it stamps nothing and says so.
# crmvec-run --stamp DIR runs it after the program; it can also be run by hand in the same shell.
#   crmvec-stamp DIR | --help | --version
case "${1-}" in
--help | -h)
  echo "usage: crmvec-stamp DIR"
  echo "Records in DIR/crmvec-libm.json (and in DIR/dataset_description.json's GeneratedBy, for a BIDS"
  echo "derivative) that the math in this environment was crmvec's correctly rounded one: the same result"
  echo "on every CPU and C library version. Run it in the environment the program ran in."
  exit 0 ;;
--version) echo "crmvec-stamp @VERSION@"; exit 0 ;;
esac
dir=${1-}
[ -n "$dir" ] && [ -d "$dir" ] || { echo "usage: crmvec-stamp DIR (DIR must exist; see crmvec-stamp --help)" >&2; exit 2; }
libm=no; vec=no
case " ${LD_PRELOAD-} " in *libcrpreload.so*) libm=yes ;; esac
case ":${LD_LIBRARY_PATH-}:" in *crmvec*) vec=yes ;; esac
if [ $libm = no ] && [ $vec = no ]; then
  echo "crmvec-stamp: crmvec is not active in this environment (no libcrpreload.so in LD_PRELOAD, no crmvec" >&2
  echo "directory in LD_LIBRARY_PATH): nothing stamped" >&2
  exit 1
fi
glibc=$( (ldd --version 2>/dev/null || true) | head -1 | sed 's/.* //')
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cat > "$dir/crmvec-libm.json" <<EOF
{
  "Name": "crmvec",
  "Version": "@VERSION@",
  "CodeURL": "https://github.com/anun333/crmvec",
  "ScalarMath": "$( [ $libm = yes ] && echo "correctly rounded (libcrpreload.so, CORE-MATH)" || echo "the system's" )",
  "VectorMath": "$( [ $vec = yes ] && echo "correctly rounded (crmvec libmvec.so.1)" || echo "the system's" )",
  "Machine": "$(uname -m)",
  "SystemCLibrary": "glibc ${glibc:-unknown}",
  "Stamped": "$now",
  "Meaning": "Correctly rounded math has one result per input, so these results do not depend on the CPU or the C library version for the functions crmvec provides. They can differ from results computed with the system's math library, which is accurate to about an ulp but not correctly rounded."
}
EOF
echo "crmvec-stamp: wrote $dir/crmvec-libm.json"
dd="$dir/dataset_description.json"
if [ -f "$dd" ]; then
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$dd" "@VERSION@" <<'PY'
import json, sys
path, version = sys.argv[1], sys.argv[2]
with open(path) as f:
    d = json.load(f)
gen = d.get("GeneratedBy")
if not isinstance(gen, list):
    gen = [] if gen is None else [gen]
if any(isinstance(g, dict) and g.get("Name") == "crmvec" for g in gen):
    print("crmvec-stamp: %s already names crmvec in GeneratedBy" % path)
else:
    gen.append({"Name": "crmvec", "Version": version,
                "Description": "correctly rounded math (see crmvec-libm.json)",
                "CodeURL": "https://github.com/anun333/crmvec"})
    print("crmvec-stamp: added crmvec to GeneratedBy in %s" % path)
d["GeneratedBy"] = gen
with open(path, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
PY
  else
    echo "crmvec-stamp: no python3, so $dd is left as it is (crmvec-libm.json has the record)"
  fi
fi
