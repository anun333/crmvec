#!/usr/bin/make -f
# crmvec: build the libraries only (make lib); the checks need MPFR, qemu and
# hours, and are run from the source tree (README, "Checking it")
# no LTO: it would optimize across crmvec.c and CORE-MATH, code no check has run on
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
include /usr/share/dpkg/architecture.mk
%:
	dh $@
override_dh_auto_build:
	$(MAKE) lib
override_dh_auto_install:
	$(MAKE) install PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) DESTDIR=$(CURDIR)/debian/crmvec
override_dh_auto_test:
override_dh_auto_clean:
	$(MAKE) clean
# private libraries in their own directory: nothing for ldconfig or shlibs
override_dh_makeshlibs:
